<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ritual Cultivation Kit — Britanical Blends</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Jost:wght@300;400;500&family=Sacramento&display=swap" rel="stylesheet">
<style>
:root{
  /* paper & cream */
  --paper-50:#FBF6EC; --paper-100:#F5EDDD; --paper-200:#EDE1CB; --paper-300:#E2D2B6; --paper-400:#D2BE9C;
  /* ink */
  --ink-900:#2B231A; --ink-700:#4A3D2E; --ink-500:#6E5D48; --ink-300:#9C8A70;
  /* the ritual layer — shared across the whole kit */
  --night-900:#16263F; --night-800:#1E3453; --night-600:#33506F;
  --gold-500:#C29A4E; --gold-300:#DCBE7C;
  /* blend bodies */
  --clay-500:#D7A183; --clay-400:#E3B79C; --wine-800:#78303B;
  --oat-500:#DEC79A; --oat-400:#E9D8B4; --wheat-700:#A9803C;
  --olive-500:#93A183; --olive-400:#AEB99F; --moss-800:#3E5138;
  --bark-700:#6B4A2F;
  --hair:rgba(43,35,26,.28);
  --dur-fast:140ms; --dur-base:240ms; --ease:cubic-bezier(.22,.61,.36,1);
  --tracking-wordmark:.34em;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0; background:var(--paper-100); color:var(--ink-900);
  font-family:"EB Garamond",Georgia,serif; font-size:16px; line-height:1.62;
}
img,svg{display:block; max-width:100%}
.wrap{max-width:1120px; margin:0 auto; padding:0 22px}

/* ---------- shared type ---------- */
.eyebrow{font-family:"Jost",system-ui,sans-serif; font-weight:400; font-size:11px; letter-spacing:.22em; text-transform:uppercase; color:var(--ink-500)}
.part{font-family:"Jost",system-ui,sans-serif; font-size:10px; letter-spacing:.18em; color:var(--ink-300)}
h1,h2,h3{font-family:"Cormorant Garamond",Georgia,serif; font-weight:400; text-transform:uppercase; margin:0; line-height:.94}
.script{font-family:"Sacramento",cursive; text-transform:none; letter-spacing:0}
.rule{height:1px; background:var(--hair); border:0; margin:0}

/* ---------- masthead ---------- */
.mast{background:var(--night-900); color:var(--paper-100); padding:44px 0 40px; position:relative}
.mast::after{content:""; position:absolute; left:0; right:0; bottom:0; height:2px; background:var(--gold-500)}
.mast .wm{font-family:"Cormorant Garamond",serif; font-size:clamp(15px,3.2vw,20px); letter-spacing:var(--tracking-wordmark); text-transform:uppercase; color:var(--gold-300); text-indent:var(--tracking-wordmark)}
.mast .fleuron{color:var(--gold-500); font-size:19px; margin:12px 0 18px}
.mast h1{font-size:clamp(40px,10.5vw,96px); color:var(--paper-50); letter-spacing:.02em}
.mast .sub{font-family:"Jost",sans-serif; font-weight:300; font-size:clamp(10px,2.3vw,12px); letter-spacing:.34em; text-transform:uppercase; color:var(--night-600); filter:brightness(1.9); margin-top:18px}
.mast .lede{max-width:34em; margin:26px auto 0; color:var(--paper-200); font-size:17px}
.mast .wrap{text-align:center}

/* ---------- section frame ---------- */
section{padding:64px 0}
.shead{display:flex; align-items:baseline; gap:16px; border-bottom:1px solid var(--hair); padding-bottom:10px; margin-bottom:34px; flex-wrap:wrap}
.shead h2{font-size:clamp(24px,5.4vw,34px); letter-spacing:.06em}
.shead .part{margin-left:auto}
.note{font-size:15px; color:var(--ink-500); max-width:36em}

/* ---------- bill of materials ---------- */
.bom{display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:1px; background:var(--hair); border:1px solid var(--hair)}
.bom .item{background:var(--paper-50); padding:20px 16px 16px; display:flex; flex-direction:column; gap:12px; transition:background var(--dur-base) var(--ease)}
.bom .item:hover{background:#fff}
.bom .icon{height:74px; display:flex; align-items:flex-end; justify-content:center}
.bom .nm{font-family:"Jost",sans-serif; font-size:11px; letter-spacing:.16em; text-transform:uppercase; color:var(--ink-900)}
.bom .dim{font-size:14px; color:var(--ink-500); font-variant-numeric:tabular-nums}

/* ---------- carton ---------- */
.carton-grid{display:grid; grid-template-columns:1.15fr 1fr; gap:34px; align-items:start}
.plate{background:var(--paper-50); border:1px solid var(--hair); padding:22px}
.plate.dark{background:var(--night-900); border-color:rgba(220,190,124,.35)}
.caption{font-family:"Jost",sans-serif; font-size:10px; letter-spacing:.18em; text-transform:uppercase; color:var(--ink-300); margin-top:14px; text-align:center}
.plate.dark .caption{color:rgba(220,190,124,.7)}

/* ---------- colourways ---------- */
.ways{display:grid; grid-template-columns:repeat(3,1fr); gap:22px}
.way{border:1px solid var(--hair); background:var(--paper-50); overflow:hidden; display:flex; flex-direction:column}
.way .band{height:6px}
.way .body{padding:22px 20px 24px}
.way h3{font-size:clamp(20px,2.6vw,27px); letter-spacing:.05em; margin-bottom:6px}
.way .desc{font-family:"Jost",sans-serif; font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:var(--ink-500); line-height:1.8}
.way .strap{font-family:"Sacramento",cursive; font-size:25px; line-height:1.05; margin:16px 0 0}
.way .specrow{display:flex; justify-content:space-between; gap:10px; font-size:14px; padding:7px 0; border-top:1px solid var(--hair); color:var(--ink-500)}
.way .specrow b{font-weight:500; color:var(--ink-900); font-family:"Jost",sans-serif; font-size:11px; letter-spacing:.1em; text-transform:uppercase}
.stage{background:var(--paper-100); padding:16px 10px 6px; border-bottom:1px solid var(--hair)}

/* ---------- copy deck ---------- */
.deck{display:grid; grid-template-columns:repeat(3,1fr); gap:22px}
.card{background:var(--paper-50); border:1px solid var(--hair); padding:24px 22px}
.card .lbl{font-family:"Jost",sans-serif; font-size:10px; letter-spacing:.18em; text-transform:uppercase; color:var(--ink-300); margin:18px 0 5px}
.card .lbl:first-child{margin-top:0}
.card p{margin:0; font-size:15.5px}
.benefits{list-style:none; margin:0; padding:0; font-size:15px}
.benefits li{padding-left:16px; position:relative}
.benefits li::before{content:"•"; position:absolute; left:2px; color:var(--ink-300)}
.panel{border-radius:14px; background:var(--paper-100); border:1px solid var(--hair); padding:16px 18px; margin-top:8px}

/* ---------- spec table ---------- */
table{width:100%; border-collapse:collapse; font-size:15px}
th,td{text-align:left; padding:11px 12px; border-bottom:1px solid var(--hair); vertical-align:top}
th{font-family:"Jost",sans-serif; font-weight:400; font-size:10px; letter-spacing:.18em; text-transform:uppercase; color:var(--ink-500)}
td:first-child{font-family:"Jost",sans-serif; font-size:11px; letter-spacing:.1em; text-transform:uppercase}
tbody tr:hover{background:var(--paper-50)}

/* ---------- footer ---------- */
footer{background:var(--night-900); color:var(--paper-200); padding:52px 0 60px; text-align:center; margin-top:20px}
footer .wm{font-family:"Cormorant Garamond",serif; font-size:16px; letter-spacing:var(--tracking-wordmark); text-indent:var(--tracking-wordmark); text-transform:uppercase; color:var(--gold-300)}
footer .fine{font-size:14px; color:var(--night-600); filter:brightness(1.7); max-width:44em; margin:22px auto 0}

/* ---------- motion ---------- */
.rise{opacity:0; transform:translateY(14px); transition:opacity var(--dur-base) var(--ease), transform var(--dur-base) var(--ease)}
.rise.in{opacity:1; transform:none}
@media (prefers-reduced-motion:reduce){.rise{opacity:1; transform:none; transition:none}}
a:focus-visible,.bom .item:focus-visible{outline:2px solid var(--gold-500); outline-offset:3px}

/* ---------- responsive ---------- */
@media (max-width:860px){
  .carton-grid{grid-template-columns:1fr}
  .ways,.deck{grid-template-columns:1fr}
  section{padding:46px 0}
}
</style>
</head>
<body>

<!-- ============ MASTHEAD ============ -->
<div class="mast">
  <div class="wrap">
    <div class="wm">Britanical Blends</div>
    <div class="fleuron">&#10086;</div>
    <h1>Ritual<br>Cultivation Kit</h1>
    <div class="sub">Nature &middot; Intention &middot; Nourishment</div>
    <p class="lede">One cup, one infuser, one blend, boxed as a single sitting. The set is drawn here as flat elevations, at the same scale, in the ink used on the cards.</p>
  </div>
</div>

<!-- ============ BILL OF MATERIALS ============ -->
<section class="wrap rise">
  <div class="shead">
    <h2>The set</h2>
    <span class="eyebrow">Seven pieces</span>
    <span class="part">RCK &middot; 01–07</span>
  </div>
  <div class="bom">

    <div class="item"><div class="icon">
      <svg width="70" height="62" viewBox="0 0 70 62" fill="none" stroke="#16263F" stroke-width="1.1"><polygon points="35,4 66,58 4,58" fill="#1E3453"/><polygon points="35,4 66,58 4,58" fill="none" stroke="#C29A4E" stroke-width=".8"/><circle cx="35" cy="41" r="9" stroke="#DCBE7C" stroke-width=".7" fill="none"/><path d="M35 14v8M29 19l3 5M41 19l-3 5" stroke="#DCBE7C" stroke-width=".7"/></svg>
    </div><div class="nm">Master carton</div><div class="dim">210 × 190 × 95 mm</div></div>

    <div class="item"><div class="icon">
      <svg width="70" height="62" viewBox="0 0 70 62" fill="none"><polygon points="35,12 62,58 8,58" fill="#D7A183" stroke="#16263F" stroke-width="1"/><path d="M35 20v6M30 24l3 4M40 24l-3 4" stroke="#16263F" stroke-width=".7"/><path d="M14 52h42" stroke="#16263F" stroke-width=".6"/></svg>
    </div><div class="nm">Blend sleeve</div><div class="dim">150 × 135 × 70 mm</div></div>

    <div class="item"><div class="icon">
      <svg width="70" height="62" viewBox="0 0 70 62" fill="none"><path d="M22 14h26l-3 44H25z" fill="#D7A183" stroke="#16263F" stroke-width="1.1"/><path d="M35 26v20M29 31c3 1 5 5 6 8M41 31c-3 1-5 5-6 8" stroke="#16263F" stroke-width=".8"/></svg>
    </div><div class="nm">Ritual cup</div><div class="dim">78 ø × 92 mm &middot; 280 ml</div></div>

    <div class="item"><div class="icon">
      <svg width="70" height="62" viewBox="0 0 70 62" fill="none"><ellipse cx="30" cy="26" rx="18" ry="6" fill="#DCBE7C" stroke="#C29A4E" stroke-width="1"/><path d="M12 26c0 10 6 18 18 18s18-8 18-18" stroke="#C29A4E" stroke-width="1"/><path d="M46 24h14a3 3 0 0 1 0 6H46" fill="#1E3453" stroke="#16263F" stroke-width="1"/></svg>
    </div><div class="nm">Gold infuser</div><div class="dim">60 ø × 45 mm</div></div>

    <div class="item"><div class="icon">
      <svg width="70" height="62" viewBox="0 0 70 62" fill="none"><rect x="16" y="20" width="38" height="30" rx="3" fill="#D7A183" stroke="#16263F" stroke-width="1"/><path d="M24 32h22M24 38h22M24 44h14" stroke="#16263F" stroke-width=".6"/></svg>
    </div><div class="nm">Name coaster</div><div class="dim">90 × 90 × 8 mm</div></div>

    <div class="item"><div class="icon">
      <svg width="70" height="62" viewBox="0 0 70 62" fill="none"><rect x="6" y="26" width="58" height="20" rx="4" fill="#C89A63" stroke="#6B4A2F" stroke-width="1.1"/><rect x="11" y="30" width="48" height="12" rx="2" stroke="#6B4A2F" stroke-width=".6"/></svg>
    </div><div class="nm">Oak tray</div><div class="dim">240 × 120 × 20 mm</div></div>

    <div class="item"><div class="icon">
      <svg width="70" height="62" viewBox="0 0 70 62" fill="none"><rect x="20" y="10" width="30" height="44" fill="#F5EDDD" stroke="#2B231A" stroke-width="1"/><path d="M26 20h18M26 26h18M26 32h12" stroke="#2B231A" stroke-width=".6"/><path d="M35 40v8" stroke="#78303B" stroke-width=".8"/></svg>
    </div><div class="nm">Product card</div><div class="dim">90 × 130 mm</div></div>

  </div>
  <p class="note" style="margin-top:20px">The tray, the coaster and the infuser are new. The card and the jar label already exist and carry through unchanged.</p>
</section>

<hr class="rule">

<!-- ============ MASTER CARTON ============ -->
<section class="wrap rise">
  <div class="shead">
    <h2>Master carton</h2>
    <span class="eyebrow">Night &amp; gold &middot; shared across the range</span>
    <span class="part">RCK &middot; 01</span>
  </div>

  <div class="carton-grid">
