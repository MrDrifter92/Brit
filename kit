    </svg>
    <div class="caption">Botanical is debossed, then hand-filled in night blue. The base stamp is debossed only, no colour.</div>
  </div>
</section>

<hr class="rule">

<!-- ============ COLOURWAYS ============ -->
<section class="wrap rise">
  <div class="shead">
    <h2>Three colourways</h2>
    <span class="eyebrow">Body tone changes &middot; the engraving does not</span>
    <span class="part">RCK &middot; 02–05</span>
  </div>

  <div class="ways">

    <!-- BEDTIME -->
    <div class="way">
      <div class="band" style="background:var(--wheat-700)"></div>
      <div class="stage">
        <svg viewBox="0 0 300 210" role="img" aria-label="Banana Bedtime Tea colourway: sleeve, cup and coaster">
          <polygon points="66,16 122,150 10,150" fill="#DEC79A" stroke="#16263F" stroke-width="1.1"/>
          <g stroke="#16263F" fill="none" stroke-width=".8">
