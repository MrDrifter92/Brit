            <circle cx="150" cy="258" r="1.6"/><circle cx="270" cy="258" r="1.6"/>
            <circle cx="132" cy="176" r="1.6"/><circle cx="288" cy="176" r="1.6"/>
          </g>
          <!-- ray fan along the base -->
          <g stroke-width=".55" opacity=".85">
            <path d="M210 300L150 268M210 300L170 262M210 300L190 258M210 300L210 256M210 300L230 258M210 300L250 262M210 300L270 268"/>
          </g>
          <!-- medallion -->
          <circle cx="210" cy="178" r="50" stroke-width=".9"/>
          <circle cx="210" cy="178" r="46" stroke-width=".5"/>
        </g>
        <g fill="#DCBE7C" font-family="Cormorant Garamond, serif" text-anchor="middle">
          <text font-size="12.5" letter-spacing="3.4"><textPath href="#arcTop" startOffset="50%">BRITANICAL</textPath></text>
          <text font-size="12.5" letter-spacing="3.4"><textPath href="#arcBot" startOffset="50%">BLENDS</textPath></text>
          <text x="210" y="184" font-size="17">&#10086;</text>
          <text x="210" y="272" font-size="30" letter-spacing="2.6">RITUAL</text>
          <text x="210" y="300" font-size="30" letter-spacing="2.6">CULTIVATION KIT</text>
        </g>
      </svg>
      <div class="caption">Front face &middot; gold foil on uncoated night board</div>
    </div>

    <div>
      <div class="plate">
        <svg viewBox="0 0 400 250" role="img" aria-label="Flat dieline of the triangular prism carton">
          <g fill="none" stroke="#2B231A">
            <rect x="60" y="70" width="90" height="120" stroke-width="1.2"/>
            <rect x="150" y="70" width="90" height="120" stroke-width="1.2"/>
            <rect x="240" y="70" width="90" height="120" stroke-width="1.2"/>
            <rect x="330" y="70" width="26" height="120" stroke-width="1.2"/>
            <polygon points="150,70 240,70 195,10" stroke-width="1.2"/>
            <polygon points="150,190 240,190 195,250" stroke-width="1.2"/>
            <g stroke-dasharray="5 4" stroke-width=".8" stroke="#9C8A70">
              <path d="M150 70v120M240 70v120M330 70v120M150 70h90M150 190h90"/>
            </g>
            <g stroke="#78303B" stroke-width=".8">
              <path d="M60 70v120"/>
            </g>
          </g>
          <g font-family="Jost, sans-serif" font-size="8.5" fill="#6E5D48" letter-spacing="1.6" text-anchor="middle">
            <text x="105" y="135">SIDE</text><text x="195" y="135">FRONT</text><text x="285" y="135">SIDE</text>
            <text x="343" y="135" transform="rotate(-90 343 135)">GLUE</text>
            <text x="195" y="46">TOP</text><text x="195" y="222">BASE</text>
          </g>
          <g stroke="#9C8A70" stroke-width=".7" fill="none">
            <path d="M60 208h90M60 204v8M150 204v8"/>
          </g>
          <text x="105" y="224" font-family="Jost, sans-serif" font-size="8.5" fill="#9C8A70" letter-spacing="1.2" text-anchor="middle">95</text>
        </svg>
        <div class="caption">Dieline &middot; equilateral prism, one glue tab, no plastic window</div>
      </div>

      <div class="plate" style="margin-top:22px">
        <table>
          <tbody>
            <tr><td>Board</td><td>900 gsm uncoated, night blue through-dyed</td></tr>
            <tr><td>Print</td><td>Gold foil, one pass. No litho, no varnish.</td></tr>
            <tr><td>Closure</td><td>Magnet-free tuck at the base, ribbon pull</td></tr>
            <tr><td>Interior</td><td>Cream fluting, unprinted</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<hr class="rule">

<!-- ============ THE CUP ============ -->
