{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/product/**",
              "export/**",
              "ui_kits/marketing/**",
              "ui_kits/packaging/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|EB Garamond|Jost|Sacramento))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, EB Garamond, Jost, Sacramento."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|background|color|straplineSize|quoteSize|padding|style|key|ref|className|style|children)$/]",
        "message": "<AccentFooter> doesn't accept that prop. Declared props: quote, background, color, straplineSize, quoteSize, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:outline|solid|soft|quiet)$/]",
        "message": "<Badge> tone must be one of 'outline' | 'solid' | 'soft' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BenefitList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|size|color|marker|style|key|ref|className|style|children)$/]",
        "message": "<BenefitList> doesn't accept that prop. Declared props: items, size, color, marker, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BlendPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:benefits|steps|borderColor|padding|style|key|ref|className|style|children)$/]",
        "message": "<BlendPanel> doesn't accept that prop. Declared props: benefits, steps, borderColor, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrewStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|key|ref|className|style|children)$/]",
        "message": "<BrewStep> doesn't accept that prop. Declared props: icon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|href|as|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, href, as, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|accent|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'accent' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|bordered|elevated|grain|padding|radius|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, bordered, elevated, grain, padding, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|aged|blush|accent|dark)$/]",
        "message": "<Card> tone must be one of 'paper' | 'aged' | 'blush' | 'accent' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fleuron'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|color|glyphColor|glyph|style|key|ref|className|style|children)$/]",
        "message": "<Fleuron> doesn't accept that prop. Declared props: width, color, glyphColor, glyph, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IngredientLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|size|color|align|style|key|ref|className|style|children)$/]",
        "message": "<IngredientLine> doesn't accept that prop. Declared props: items, size, color, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IngredientLine'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<IngredientLine> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logomark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|src|alt|style|key|ref|className|style|children)$/]",
        "message": "<Logomark> doesn't accept that prop. Declared props: size, src, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OrnateFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|inset|radius|corners|style|key|ref|className|style|children)$/]",
        "message": "<OrnateFrame> doesn't accept that prop. Declared props: children, color, inset, radius, corners, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|color|length|thickness|style|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: orientation, color, length, thickness, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<Rule> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScriptQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|lines|size|color|align|style|key|ref|className|style|children)$/]",
        "message": "<ScriptQuote> doesn't accept that prop. Declared props: children, lines, size, color, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScriptQuote'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<ScriptQuote> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|color|align|weight|as|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, size, color, align, weight, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<SectionLabel> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Strapline'] > JSXAttribute > JSXIdentifier[name!=/^(?:words|size|color|font|style|key|ref|className|style|children)$/]",
        "message": "<Strapline> doesn't accept that prop. Declared props: words, size, color, font, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Strapline'] > JSXAttribute[name.name='font'] > Literal[value!=/^(?:serif|sans)$/]",
        "message": "<Strapline> font must be one of 'serif' | 'sans'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|as|align|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, color, as, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl|display)$/]",
        "message": "<Wordmark> size must be one of 'sm' | 'md' | 'lg' | 'xl' | 'display'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Wordmark> align must be one of 'left' | 'center' | 'right'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
